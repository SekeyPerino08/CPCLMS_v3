{
  "name": "cpclibrary-backend",
  "version": "1.0.0",
  "description": "Smart Library Management System - Backend API",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/app.ts",
"predev":"node -e \"var p=require('path'),s=require('child_process'),f=p.join(__dirname,'scripts',process.platform==='win32'?'kill-port.ps1':'kill-port.sh');s.execFileSync(process.platform==='win32'?'powershell':'bash',[process.platform==='win32'?'-File':'-e',f],{cwd:__dirname,stdio:'inherit',shell:true})\"",
    "build": "tsc",
    "start": "node dist/app.js",
"kill-port": "node -e \"var p=require('path'),s=require('child_process'),f=p.join(__dirname,'scripts',process.platform==='win32'?'kill-port.ps1':'kill-port.sh'),port=process.argv[1]||'';s.execFileSync(process.platform==='win32'?'powershell':'bash',[process.platform==='win32'?'-File':'-e',f].concat(port?[port]:[]),{cwd:__dirname,stdio:'inherit',shell:true})\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.6",
    "@types/qrcode": "^1.5.6",
    "nodemon": "^3.1.7",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
