# ============================================================
# CPCLMS Backend - Environment Variables Example (.env.example)
# ============================================================
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database (NeonDB PostgreSQL) ---
# Get your DATABASE_URL from https://console.neon.tech
DATABASE_URL=postgresql://neondb_owner:npg_82EOBIFscetK@ep-holy-pond-ap0ipk29-pooler.c-7.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- JWT Authentication ---
# Generate secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_min_16_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_16_chars
JWT_REFRESH_EXPIRES_IN=7d

# --- Frontend ---
FRONTEND_URL=http://localhost:3000

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Cookie / Security ---
COOKIE_SECRET=your_cookie_secret_here

