# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/cpclibrary?schema=public"

# JWT — Access Token (short-lived)
JWT_SECRET="your-super-secret-jwt-key-min-16-chars"
JWT_EXPIRES_IN="15m"

# JWT — Refresh Token (long-lived, stored in DB for rotation)
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-16-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS + cookie domain)
FRONTEND_URL="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Cookie
COOKIE_SECRET="cookie-secret-change-me"

