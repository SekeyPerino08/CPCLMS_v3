# ============================================================
# CPCLMS Backend - Environment Variables (.env)
# ============================================================
# IMPORTANT: This file contains real credentials. Never commit it!
# Copy .env.example and fill in your values instead.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database (NeonDB PostgreSQL) ---
# Replace with your actual NeonDB connection string
DATABASE_URL=postgresql://neondb_owner:npg_82EOBIFscetK@ep-holy-pond-ap0ipk29-pooler.c-7.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- JWT Authentication ---
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=my_super_secret_jwt_key_change_me_in_production_123456
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=my_super_secret_refresh_key_change_me_in_production_123456
JWT_REFRESH_EXPIRES_IN=7d

# --- Frontend ---
FRONTEND_URL=http://localhost:3000

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Cookie / Security ---
COOKIE_SECRET=my_cookie_secret_change_me_123456

